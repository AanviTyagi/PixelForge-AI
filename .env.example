# Magic Hour API Keys (Primary, Secondary, Tertiary)
MAGIC_HOUR_API_KEY=your_primary_magic_hour_key
MAGIC_HOUR_API_KEY_SECONDARY=your_secondary_magic_hour_key
MAGIC_HOUR_API_KEY_TERTIARY=your_tertiary_magic_hour_key

# Replicate API Key (used for fallback or proxying)
REPLICATE_API_TOKEN=your_replicate_token_here

# Cloudinary Credentials (used for output storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MongoDB Connection String (used for job history storage)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Uploadcare Credentials (used for source image uploading)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=your_uploadcare_public_key
UPLOADCARE_SECRET_KEY=your_uploadcare_secret_key

# App URL — must be HTTPS in production for webhooks / API calls
NEXT_PUBLIC_APP_URL=http://localhost:3000
